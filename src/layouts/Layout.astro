---
interface Props {
  title?: string;
  description?: string;
}

const { title = 'Kashmir Charity', description = 'Supporting communities in Kashmir.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    font-family: system-ui, sans-serif;
    line-height: 1.5;
    color: #1f2937;
    background: #fff;
  }

  body {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
  }
</style>